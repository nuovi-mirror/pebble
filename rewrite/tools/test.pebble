New "la s++ la" '1'
New "ab s++ ab" '2'
New "ab s++ cd" '3'
New i "0 s++ 1"

_PRINT2 lala
_PRINT2 abab
_PRINT2 abcd
_PRINT2 i

Func a
_PRINT funca
End

Call a

Func b 
_PRINT funcb
End

Call b
