_PRINT 1
_PRINT -1
_PRINT 1.2
_PRINT abcd

New a '1'
New b '-1'
New c '1.2'
New d 'abcd'

_PRINT2 a
_PRINT2 b
_PRINT2 c
_PRINT2 d

New e "1 + 2"
New f "8 - 2"
New g "4 / 2"
New h "2 * 2"

_PRINT2 e
