Func print
New __Escape_std.io.print_ARG0 <msg>
Escape std.io.print
End

New text 'Hello from Pebble!'
New replacement 'to'
New toreplace 'from'

New pos "text sf toreplace"
New left "text ssl pos"
New tright "text ssr (pos - 1)"

New trlen "toreplace sl magical"

New right "tright ssr trlen"

New msg "left s++ replacement s++ right"
Call print
