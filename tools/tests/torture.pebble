# depends on:
#  escape sequence std.io.print from stdpbl version 1 or greater
#  excape sequence std.io.printLn from stdpbl version 1 or greater

New result ''
New expected ''

# helpers
Func record
New result "result s++ record"
End

Func expect
New expected "expected s++ expect"
End

Func print
New __Escape_std.io.print_ARG0 <msg>
Escape std.io.print
End

Func printLn
New __Escape_std.io.printLn_ARG0 <msg>
Escape std.io.printLn
End

Func PASS
New msg 'PASS'
Call print
End

Func FAIL
New msg 'FAIL'
Call print

New msg ''
Call print

New msg 'Has      : '
Call printLn

New msg result
Call print

New msg 'Expected : '
Call printLn

New msg expected
Call print
End

# bytecode 2

# expressions
New record "1 + 01"
Call record
New expect '2'
Call expect

New record "18 + 0003"
Call record
New expect '21'
Call expect

New 2 '5'
New record "2 s++ 08"
Call record
New expect '208'
Call expect

New 4 '6'
New 000001 "4 s++ 32" 
New record 000001
Call record
New expect '432'
Call expect

New 10000 "4 s++ 32" 
New record 10000
Call record
New expect '432'
Call expect

New record "3 / 2"
Call record
New expect '1'
Call expect

New record "3 % 2"
Call record
New expect '1'
Call expect

New record "13 + -1"
Call record
New expect '12'
Call expect

New record "1 + -3"
Call record
New expect '-2'
Call expect

New record "1 - 18"
Call record
New expect '-17'
Call expect

New record "1 * 32"
Call record
New expect '32'
Call expect

New record "1 * -12"
Call record
New expect '-12'
Call expect

New record "0 * 3"
Call record
New expect '0'
Call expect

New record "0 / 2"
Call record
New expect '0'
Call expect

New record "1 == 4"
Call record
New expect '1'
Call expect

New record "1 == 1"
Call record
New expect '0'
Call expect

New record "1 > 0"
Call record
New expect '0'
Call expect

New record "1 < 0"
Call record
New expect '1'
Call expect

New record "1 > 1"
Call record
New expect '1'
Call expect

New record "1.2 + 3.3"
Call record
New expect '4.5'
Call expect

New record '12.890000'
Call record
New expect '12.89'
Call expect

New record '19.1200900'
Call record
New expect '19.12009'
Call expect

New record '0123456789'
Call record
New expect '0123456789'
Call expect

New record '9876543210'
Call record
New expect '9876543210'
Call expect

New record "a s++ b"
Call record
New expect 'ab'
Call expect

New record "abc s?= ab"
Call record
New expect '0'
Call expect

New record "abc s?= w"
Call record
New expect '1'
Call expect

New record "abc e?= bc"
Call record
New expect '0'
Call expect

New record "abc e?= q"
Call record
New expect '1'
Call expect

New record "(1 + 2) * 3"
Call record
New expect '9'
Call expect

New record "(1 == 1) + 1"
Call record
New expect '1'
Call expect

# compare
New res "expected ?= result"
If PASS "res == 0"
If FAIL "res != 0"

