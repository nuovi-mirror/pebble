include stdlib

fn main ( ) ret {
	ret init arrcount = '0'

	arr[0] = '0'
	arrlen = '12'  / size
	data = 'lalalala'
	data2 = 'falalala'

	call std.array.init ( <arr> arrlen init )
	call std.array.append ( <arr> arrlen <arrcount> data )
	call std.array.append ( <arr> arrlen <arrcount> data2 )

	call std.io.print ( "0: s++ arr[0]" )
	call std.io.print ( "1: s++ arr[1]" )
	call std.io.print ( "2: s++ arr[2]" )
	call std.io.print ( "len: s++ arrlen" )
	call std.io.print ( "count: s++ arrcount" )

	call std.array.shift ( <arr> <arrlen> <arrcount> 'right' '1' )
	call std.io.print ( 'shifted right' )

	call std.io.print ( "0: s++ arr[0]" )
	call std.io.print ( "1: s++ arr[1]" )
	call std.io.print ( "2: s++ arr[2]" )
	call std.io.print ( "len: s++ arrlen" )
	call std.io.print ( "count: s++ arrcount" )

	call std.array.shift ( <arr> <arrlen> <arrcount> 'left' '1' )
	call std.io.print ( 'shifted left' )

	call std.io.print ( "0: s++ arr[0]" )
	call std.io.print ( "1: s++ arr[1]" )
	call std.io.print ( "2: s++ arr[2]" )
	call std.io.print ( "len: s++ arrlen" )
	call std.io.print ( "count: s++ arrcount" )
}
