. # New Rock Standard Library (stdlib)

fn std.io.print ( value ) data {
. New _fstd.io.print_data {_fstd.io.print_value}
. New __Escape_std.io.print_ARG0 <_fstd.io.print_data>
. Escape std.io.print
}

fn std.io.printRaw ( value ) value {
. New __Escape_std.io.printLn_ARG0 <_fstd.io.printRaw_value>
. Escape std.io.printLn
}

fn std.io.printLn ( value ) data {
. New _fstd.io.printLn_data {_fstd.io.printLn_value}
. New __Escape_std.io.printLn_ARG0 <_fstd.io.printLn_data>
. Escape std.io.printLn
}
	
fn std.io.input ( ) input {
. Escape std.io.input
. New _fstd.io.input_input __Escape_std.io.input_RET0
}

/ misc

fn std.misc.random ( ) random {
. Escape std.misc.random
. New _fstd.misc.random_random __Escape_std.misc.random_RET0
}

fn std.misc.sleep ( time ) time {
. Yield <_fstd.misc.sleep_time>
}

/ proc

fn std.proc.spawn ( args ) ret {
. New __Escape_std.proc.spawn_ARG0 <_fstd.proc.spawn_args>
. Escape std.proc.spawn
. New _fstd.proc.spawn_ret __Escape_std.proc.spawn_RET0
}

fn std.proc.wait ( id ) type status {
. New __Escape_std.proc.wait_ARG0 <_fstd.proc.wait_id>
. Escape std.proc.wait
. New _fstd.proc.wait_type __Escape_std.proc.wait_RET1
. New _fstd.proc.wait_status __Escape_std.proc.wait_RET0
}

/ term

fn std.term.screen.clear ( ) ret {
. Escape std.term.screen.clear
. New _fstd.term.screen.clear_ret '0'
}

fn std.term.color.basic.fore ( color ) ret {
. New __Escape_std.term.color.basic.fore_ARG0 <_fstd.term.color.basic.fore_color>
. Escape std.term.color.basic.fore
	ret = color
}

fn std.term.color.basic.back ( color ) ret {
. New __Escape_std.term.color.basic.back_ARG0 <_fstd.term.color.basic.back_color>
. Escape std.term.color.basic.back
	ret = color
}

fn std.term.cursor.moveAbsolute ( x y ) ret {
. New __Escape_std.term.cursor.moveAbsolute_ARG0 <_fstd.term.cursor.moveAbsolute_x>
. New __Escape_std.term.cursor.moveAbsolute_ARG1 <_fstd.term.cursor.moveAbsolute_y>
. Escape std.term.cursor.moveAbsolute
	ret = '0'
}

/ tasks

. New _std.task.count '0'
. New _std.task.slot '_awt_ s++ _T'

fn std.task.spawn ( name ) handle {
. New _std.task.count "_std.task.count + 1"
. New _fstd.task.spawn_handle "_std.task.done s++ _std.task.count"
. Spawn <_fstd.task.spawn_name> <_fstd.task.spawn_handle>
}

fn std.task.spawn1 ( name arg ) handle {
. New _fstd.task.spawn1_t '_f s++ _fstd.task.spawn1_name s++ __A0'
. New {_fstd.task.spawn1_t} _fstd.task.spawn1_arg
. New _std.task.count "_std.task.count + 1"
. New _fstd.task.spawn1_handle "_std.task.done s++ _std.task.count"
. Spawn <_fstd.task.spawn1_name> <_fstd.task.spawn1_handle>
. Yield 0
}

fn std.task.yield ( ms ) ret {
. Yield <_fstd.task.yield_ms>
	ret = '0'
}

fn std.task.done ( handle ) done {
. New _fstd.task.done_done [_fstd.task.done_handle]
}

. Func __std.task.await_loop
. Yield 30
. New __std.task.n {_std.task.slot}
. New __std.task.v [_std.task.n]
. New __std.task.w [_std.task.v]
. If __std.task.await_loop <_std.task.w>
. End

fn std.task.await ( handle ) ret {
. New _std.task.n {_std.task.slot}
. New {_std.task.n} _fstd.task.await_handle
. Call _std.task.await_loop
	ret = '0'
}

/ files

fn std.fs.file.write ( file data ) code {
. New __Escape_std.fs.file.write_ARG0 <_fstd.fs.file.write_file>
. New __Escape_std.fs.file.write_ARG1 <_fstd.fs.file.write_data>
. Escape std.fs.file.write
. New _fstd.fs.file.write_code __Escape_std.fs.file.write_RET0
}

fn std.fs.file.read ( file ) code data {
. New __Escape_std.fs.file.read_ARG0 <_fstd.fs.file.read_file>
. Escape std.fs.file.read
. New _fstd.fs.file.read_code __Escape_std.fs.file.read_RET0
. New _fstd.fs.file.read_data __Escape_std.fs.file.read_RET1
}

fn std.fs.dir.get ( ) dir {
. Escape std.fs.dir.get
. New _fstd.fs.dir.get_dir __Escape_std.fs.dir.get
}

fn std.fs.dir.list ( dir ) code files {
. New __Escape_std.fs.dir.list_ARG0 <_fstd.fs.dir.list_dir>
. Escape std.fs.dir.list
. New _fstd.fs.dir.list_code __Escape_std.fs.dir.list_RET0
. New _fstd.fs.dir.list_files __Escape_std.fs.dir.list_RET1
}
	
/ argument handling

fn std.arg.get ( n ) code arg {
	import VMARGC
	arg = '0'
	code = '1'
	if ( "((n < VMARGC) + (n >= 0)) == 0" ) {
		name = "VMARG s++ n"
		arg = [name]
		code = '0'
	}
}

/ string

fn std.str.replace ( text toreplace replacement ) ret {
	pos = "text sf toreplace"
	left = "text ssl pos"
	tright = "text ssr (pos - 1)"
	trlen = "toreplace sl pos"
	right = "tright ssr trlen"
	ret = "left s++ replacement s++ right"
}

/ array

fn std.array.init ( arrptr len set ) len {
/ <arrptr> 'len' 'set'
	i = '0'

	while ( "i < len" ) {
		[arrptr][i] = set
		i = "i + 1"
	}
}

fn std.array.join ( arrptr len char ) str {
/ <arrptr> 'len' 'char'
	i = '1'
	str = [arrptr][0]

	while ( "i < len" ) {
		str = "str s++ char s++ [arrptr][i]"
		i = "i + 1"
	}
}

fn std.array.split ( arrptr len str char ) i {
/ <arrptr> 'len' 'str' 'char'
	i = '0'

	while ( "i < len" ) {
		pos = "str sf char"
		l = "str ssl pos"
		str = "str ssr pos"
		[arrptr][i] = l
		i = "i + 1"
		if ( "pos == 0" ) { return }
	}
}

. # end of New Rock Standard Library (stdlib)
