
include stdlib

fn main ( ) ret {
	ret = '0'
	pid = call std.proc.spawn ( 'ls -ah' )
	type status = call std.proc.wait ( pid )

	if ( "type == 0" ) {
		msg = 'Killed by signal '
		export msg
	} else {
		msg = 'Exited with status '
		export msg
	}

	call std.io.printLn ( msg )
	call std.io.print ( status )
		
}	
