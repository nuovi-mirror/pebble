. # New Rock Standard Library (stdlib)

fn std.io.print ( value ) data {
. New __Func_std.io.print_data {__Func_std.io.print_value}
. New __Escape_std.io.print_ARG0 <__Func_std.io.print_data>
. Escape std.io.print
}

fn std.io.printRaw ( value ) value {
. New __Escape_std.io.print_ARG0 <__Func_std.io.printRaw_value>
. Escape std.io.print
}

fn std.io.printLn ( value ) data {
. New __Func_std.io.printLn_data {__Func_std.io.printLn_value}
. New __Escape_std.io.printLn_ARG0 <__Func_std.io.printLn_data>
. Escape std.io.printLn
}
	
fn std.io.input ( ) input {
. Escape std.io.input
. New __Func_std.io.input_input __Escape_std.io.input_RET0
}

/ misc

fn std.misc.random ( ) random {
. Escape std.misc.random
. New __Func_std.misc.random_random __Escape_std.misc.random_RET0
}

fn std.misc.sleep ( time ) time {
. Yield <__Func_std.misc.sleep_time>
}

/ proc

fn std.proc.spawn ( args ) ret {
. New __Escape_std.proc.spawn_ARG0 <__Func_std.proc.spawn_args>
. Escape std.proc.spawn
. New __Func_std.proc.spawn_ret __Escape_std.proc.spawn_RET0
}

fn std.proc.wait ( id ) type status {
. New __Escape_std.proc.wait_ARG0 <__Func_std.proc.wait_id>
. Escape std.proc.wait
. New __Func_std.proc.wait_type __Escape_std.proc.wait_RET1
. New __Func_std.proc.wait_status __Escape_std.proc.wait_RET0
}

/ term

fn std.term.screen.clear ( ) ret {
. Escape std.term.screen.clear
. New __Func_std.term.screen.clear_ret '0'
}

fn std.term.color.basic.fore ( color ) ret {
. New __Escape_std.term.color.basic.fore_ARG0 <__Func_std.term.color.basic.fore_color>
. Escape std.term.color.basic.fore
	ret = color
}

fn std.term.color.basic.back ( color ) ret {
. New __Escape_std.term.color.basic.back_ARG0 <__Func_std.term.color.basic.back_color>
. Escape std.term.color.basic.back
	ret = color
}

fn std.term.cursor.moveAbsolute ( x y ) ret {
. New __Escape_std.term.cursor.moveAbsolute_ARG0 <__Func_std.term.cursor.moveAbsolute_x>
. New __Escape_std.term.cursor.moveAbsolute_ARG1 <__Func_std.term.cursor.moveAbsolute_y>
. Escape std.term.cursor.moveAbsolute
	ret = '0'
}

/ tasks

. New __std.task.count '0'
. New __std.task.slot '__await_ s++ __task'

fn std.task.spawn ( name ) handle {
. New __std.task.count "__std.task.count + 1"
. New __Func_std.task.spawn_handle "__std.task.done s++ __std.task.count"
. Spawn <__Func_std.task.spawn_name> <__Func_std.task.spawn_handle>
}

fn std.task.spawn1 ( name arg ) handle {
. New __Func_std.task.spawn1_t '__Func_ s++ __Func_std.task.spawn1_name s++ _ARG0'
. New {__Func_std.task.spawn1_t} __Func_std.task.spawn1_arg
. New __std.task.count "__std.task.count + 1"
. New __Func_std.task.spawn1_handle "__std.task.done s++ __std.task.count"
. Spawn <__Func_std.task.spawn1_name> <__Func_std.task.spawn1_handle>
}

fn std.task.yield ( ms ) ret {
. Yield <__Func_std.task.yield_ms>
	ret = '0'
}

fn std.task.done ( handle ) done {
. New __Func_std.task.done_done [__Func_std.task.done_handle]
}

. Func __std.task.await_loop
. Yield 1
. New __std.task.n {__std.task.slot}
. New __std.task.v [__std.task.n]
. New __std.task.w [__std.task.v]
. If __std.task.await_loop <__std.task.w>
. End

fn std.task.await ( handle ) ret {
. New __std.task.n {__std.task.slot}
. New {__std.task.n} __Func_std.task.await_handle
. Call __std.task.await_loop
	ret = '0'
}

. # end of New Rock Standard Library (stdlib)
