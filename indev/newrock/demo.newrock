include add.newrock

fn main ( ) total {
	x = '0'
	total = '0'

	while ( "x < 3" ) {
		y = '0'

		while ( "y < 3" ) {
			sum = call add ( x y )

			if ( "sum == 0" ) {
				call std.io.print ( 'zero' )
			} else if ( "sum == 1" ) {
				call std.io.print ( 'one' )
			} else if ( "sum == 2" ) {
				call std.io.print ( 'two' )
			} else {
				call std.io.print ( sum )
			}

			updated_total = call add ( total sum )
			total = updated_total

			y = "y + 1"
		}

		x = "x + 1"
	}
	
	number = call std.misc.random ( )
	call std.io.print ( number )
	call std.io.print ( total )
}
