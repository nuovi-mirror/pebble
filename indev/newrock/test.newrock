fn main ( ) result {
	x = '0'

	while ( "x < 3" ) {
		y = '0'

		while ( "y < 3" ) {
			y = "y + 1"
		}

		classification = call classify ( x )
		call std.io.print ( classification )

		x = "x + 1"
	}

	result = 'done'
}

fn classify ( value ) result {
	if ( "value == 0" ) {
		result = 'zero'
	} else if ( "value == 1" ) {
		result = 'one'
	} else if ( "value == 2" ) {
		result = 'two'
	}
}
