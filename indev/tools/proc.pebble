New args 'ls .'
New __Escape_std.proc.spawn_ARG0 <args>
Escape std.proc.spawn
New __Escape_std.proc.wait_ARG0 <__Escape_std.proc.spawn_RET0>
Escape std.proc.wait

Func sexit
New msg 'Exited with signal '
End

Func nexit 
New msg 'Exited with status '
End

New __Escape_std.io.print_ARG0 <msg>
New __Escape_std.io.printLn_ARG0 <msg>

If sexit "__Escape_std.proc.wait_RET1 == 0>"
If nexit "__Escape_std.proc.wait_RET1 != 0"

Escape std.io.printLn

New msg __Escape_std.proc.wait_RET0
Escape std.io.print
