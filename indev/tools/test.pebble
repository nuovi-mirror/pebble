# this is a comment

_GETMEM

_NOP
_NOP
_NOP

_PRINT 1
_PRINT -1
_PRINT 1.2
_PRINT abcd

New a '1'
New b '-1'
New c '1.2'
New d 'abcd'

_PRINT2 a
_PRINT2 b
_PRINT2 c
_PRINT2 d

New e "1 + 2"
New f "8 - 2"
New g "4 / 2"
New h "2 * 2"

_PRINT2 e
_PRINT2 f
_PRINT2 g
_PRINT2 h

New "la s++ la" '1'
New "ab s++ ab" '2'
New "ab s++ cd" '3'
New i '0 s++ 1'
New j {i}

_PRINT2 lala
_PRINT2 abab
_PRINT2 abcd
_PRINT2 j

New {i} '1'
_PRINT2 01

New k '1'
New l k
_PRINT2 l

Func 'a'
_PRINT funca
End

If a "1 > 0"
If a "1 < 0"
Call a

Func b 
_PRINT funcb
_PRINT funcb_2
End

Call b

Func c
_PRINT funcc
_PRINT calling_a
Call a
End

Call c

Func r
Return
_PRINT2 broken
End

Call r

New foo 'bar'
New <foo> 'qux'
# bar = qux
_PRINT2 bar

New quux <foo>
# quux = foo
_PRINT2 quux

_GETMEM

New msg 'This will segfault now'
New __Escape_std.io.print_ARG0 <msg>
Escape std.io.print
_SEGFAULT
