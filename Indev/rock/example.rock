// the '/' character represents a comment
// if the comment character is the first
// character of a line, the line is a
// comment. comments can only be on the
// first line.

// define a function taking two arguemnts
// argument one should be a and argument
// two should be b
// the function should return the result of
// x
fn func ( a b ) x {

// function body

// store the result of the expression as x
x = `a + b

// store the literal as y
y = !1

// store a copy of y as z
z = @y

// functions cannot use variables outside of their
// scope. Instead, the import and export instructions
// are used to allow them to.
// Keep in mind this is done by the compiler.

//export x
// function var x is now global x (copied)

//import x
// copy globar var x to local var x

// however, those are commented out for this program 
// since they are not needed.

// end the function
}

w = !1

// copy the result of the function 
// return to the variable x
x = :func ( 12 24 )

// call function with the variable as the first argument
// print is part of the standard library, injected into
// the source code of every program
call std.io.print ( x )

// if statements follow simular syntax to the fn keyword
// if ( <expr> ) { <body> }
if ( 6 > 5 ) {
msg = !greater than 5
call std.io.print ( msg )
}
