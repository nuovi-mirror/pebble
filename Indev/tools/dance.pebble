
New 1.1 ' (**)/'
New 1.2 '<)  )'
New 1.3 ' /  \'

New 2.1 '\(**)'
New 2.2 ' (  )>'
New 2.3 ' /  \'

New time '500' # 500ms

Func reset
Escape std.term.screen.clear
New x '0'
New y '0'
New ARG1 'x'
New ARG2 'y'
Escape std.term.cursor.moveAbsolute
End

Func p1
New ARG1 '1.1'
Escape std.io.print
New ARG1 '1.2'
Escape std.io.print
New ARG1 '1.3'
Escape std.io.print
End

Func p2
New ARG1 '2.1'
Escape std.io.print
New ARG1 '2.2'
Escape std.io.print
New ARG1 '2.3'
Escape std.io.print
End

Func sleep
New ARG1 'time'
Escape std.misc.sleep
End

Func loop

Call reset
Call p1
Call sleep
Call reset
Call p2
Call sleep
Call loop
End

Call loop
