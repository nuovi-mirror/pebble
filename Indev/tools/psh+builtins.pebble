#!/usr/bin/pebble

New prompt '> '

Func getArg
New separator ' '
# grabs an argument from a string
# data = payload to give it
New ARG1 'data'
New ARG2 'separator'
Escape std.str.find
New ARG2 'entry'
Escape std.str.split.num.right
Escape std.str.split.num.left
New data strRight # modifies data to remove the arg
New arg strLeft # returns arg as the arugment
End

Func loop
New ARG1 'prompt'
Escape std.io.printLn
Escape std.io.input
New command input

If exit "command ?= exit"
If cd "command -?= cd"
If echo "command -?= echo"
If pwd "command -?= pwd"
If ls "command -?= ls"

New ARG1 'command'
Escape std.proc.spawn
New ARG1 'pid'
Escape std.proc.wait

Call loop
End

Func exit
New ARG1 'msg'
New msg 'Goodbye!'
Escape std.io.print
Escape std.proc.exit
Call loop
End

Func cd
#Escape std.io.print
New ARG1 'input'
New num '3'
New ARG2 'num'
Escape std.str.split.num.right
New ARG1 'strRight'
Escape std.fs.dir.change
Call loop
End

Func echo
New data input
Call getArg # data now contains the args
New ARG1 'data'
Escape std.io.print
Call loop
End

Func pwd
Escape std.fs.dir.get
New ARG1 'cwd'
Escape std.io.print
Call loop
End

Func ls
New data input
Call getArg 
New ARG1 'data'
If _ls "data ?=  "
Escape std.fs.dir.list
New ARG1 'dirContents'
Escape std.io.print
Call loop
End

Func _ls
New data '.'
End

Call loop
