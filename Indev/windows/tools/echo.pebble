#!/usr/bin/pebble

New counter '2'
New ARGS ''
New spacer ' '

Func printArg
New CURRARG "VMARG s++ counter"
New counter "counter + 1"
New ARG1 CURRARG
Escape PrintLn
New ARG1 'spacer'
Escape PrintLn
End

Func loop
If printArg "counter < VMARGC"
If loop "counter < VMARGC"
End

Call loop
Escape Print
